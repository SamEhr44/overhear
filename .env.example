# ── apps/web (NEXT_PUBLIC_* values are public — safe to expose) ──────────────
# WebSocket endpoint of the caption API. Unset → the UI shows an honest
# "No caption API yet" state. Dev falls back to ws://localhost:8787/ws/listen.
NEXT_PUBLIC_API_WS_URL=wss://overhear-api.fly.dev/ws/listen
NEXT_PUBLIC_API_HTTP_URL=https://overhear-api.fly.dev

# ── services/api (server-side only — set with `fly secrets set`, never commit) ─
# PORT=8787
# ALLOWED_ORIGINS=https://overhear.vercel.app,http://localhost:3000
# LOG_LEVEL=info
# M1+ (translation providers — keys stay server-side only):
# DEEPGRAM_API_KEY=
# DEEPL_API_KEY=
# Error tracking (both are no-ops until set — no PII, never audio/captions):
# SENTRY_DSN=                # api: fly secrets set SENTRY_DSN=...
# NEXT_PUBLIC_SENTRY_DSN=    # web: set in Vercel; browser SDK loads lazily only when present
